api.aztech-ai.com {
	# Auth API - automatically strips /auth-api prefix
	handle_path /auth-api/* {
		reverse_proxy 127.0.0.1:8080
	}

	# Apps API - automatically strips /apps-api prefix
	handle_path /apps-api/* {
		reverse_proxy 127.0.0.1:8081
	}

	# Banxico API - automatically strips /banxico-api prefix
	handle_path /banxico-api/* {
		reverse_proxy 127.0.0.1:8082
	}
	# People API - automatically strips /people-api prefix
	handle_path /people-api/* {
		reverse_proxy 127.0.0.1:8083
	}
	# Profile API - automatically strips /profile-api prefix
	handle_path /profile-api/* {
		reverse_proxy 127.0.0.1:8084
	}
}
