# ========== AUTH SERVER PRODUCTION ==========
app.auth.aztech-ai.com {
    tls internal
    reverse_proxy authserver-frontend:3000
}

api.auth.aztech-ai.com {
    tls internal
    reverse_proxy https://authserver-backend:8080 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

# ========== AUTH SERVER TEST ==========
app.auth-test.aztech-ai.com {
    tls internal
    reverse_proxy authserver-test-frontend:3000
}

api.auth-test.aztech-ai.com {
    tls internal
    reverse_proxy https://authserver-test-backend:8080 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}