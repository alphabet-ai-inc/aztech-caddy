# Production domains - specific subdomains for HTTP-01 challenges
auth-api.aztech-ai.com {
	reverse_proxy 127.0.0.1:8080
}
apps-api.aztech-ai.com {
	reverse_proxy 127.0.0.1:8081
}

users-api.aztech-ai.com {
	reverse_proxy 127.0.0.1:8082
}

